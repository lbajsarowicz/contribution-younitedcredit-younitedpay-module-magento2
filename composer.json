{
    "name": "younitedcredit/younitedpay-module-magento2",
    "type": "magento2-module",
    "version": "1.2.2",
    "license": "AFL-3.0",
    "description": "Official module for Younited Pay integration.",
    "require": {
        "202ecommerce/younitedpay-sdk": "3.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "YounitedCredit\\YounitedPay\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
